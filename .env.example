# Copy this file to .env, run `chmod 600 .env`, and fill only the values you use.
# Never commit the populated .env file.
AMSC_TOKEN=

# ALCF and NERSC direct IRI credentials are obtained interactively through
# Globus and cached by amsc-client in ~/.amsc/credentials.json. They do not
# belong in this file.

# OLCF S3M uses independent static tokens for its open and moderate enclaves.
OLCF_S3M_TOKEN_OPEN=
OLCF_S3M_TOKEN_MODERATE=
